# Fournisseur du classement : anthropic (Claude), mistral ou gemini.
# Sans clé pour le fournisseur choisi, seule l'ingestion tourne.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Modèle (vide = défaut du fournisseur : claude-opus-5-5, mistral-large-latest, gemini-3.8-flash)
LLM_MODEL=
# Niveau d'effort, Claude uniquement (low, medium, high, xhigh, max)
LLM_EFFORT=medium
LLM_CONCURRENCY=4
# Nombre max. de scrutins envoyés au LLM par exécution (garde-fou de coût)
CLASSIFY_LIMIT=300
# Natures classées, par priorité (ensemble,partie,motion,article,amendement,autre)
CLASSIFY_NATURES=ensemble,partie,motion,article,amendement,autre

# Pipeline automatique (cron, heure de Paris). Vide = désactivé.
PIPELINE_CRON=30 6 * * *
# Télécharger l'archive des amendements (~370 Mo) pour classer les amendements sur leur texte
INGEST_AMENDEMENTS=1

# Back-office /admin (désactivé si vide)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Port exposé sur la machine hôte
APP_PORT=8090
